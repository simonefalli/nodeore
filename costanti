'Selettore cartelle
Public Function Folders(Intesta As String, MASCHERA As Form, Campo As CONTROL)
  Dim bInf As BrowseInfo
  Dim RETVAL As Long, PathID As Long, RetPath As String, Offset As Integer
  
  ' impostazione degli elementi della struttura
  bInf.hOwner = MASCHERA.hWnd
  bInf.lpszTitle = Intesta
  bInf.ulFlags = BIF_RETURNONLYFSDIRS
  
  ' Mostra il "Browse For Folder" dialog
  PathID = SHBrowseForFolder(bInf)
  RetPath = Space$(512)
  
  ' Recupero il path
  RETVAL = SHGetPathFromIDList(ByVal PathID, ByVal RetPath)
  
  If RETVAL Then
      Offset = InStr(RetPath, Chr$(0))
      Campo = Left$(RetPath, Offset - 1)
  Else
      Campo = Null
  End If
End Function


